[Unit]
Description=MetaTrader 5 Headless Client (Wine + Xvfb)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu
Environment=WINEPREFIX=/home/ubuntu/.wine
Environment=WINEARCH=win64
ExecStart=/home/ubuntu/mt5-wrapper.sh
Restart=always
RestartSec=10
LimitNOFILE=65536
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
